<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'CMS' %> - Istituzione Pubblica</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="navbar-brand"><a href="/">Istituzione Pubblica</a></div>
    <div class="navbar-menu">
      <a href="/" class="nav-link">Home</a>
      <a href="/notizie" class="nav-link">Notizie</a>
      <% (typeof pages !== 'undefined' ? pages : []).forEach(p => { %>
        <a href="/pagina/<%= p.slug %>" class="nav-link"><%= p.title %></a>
      <% }); %>
    </div>
  </nav>
  <main class="main-content">
